# Server
PORT=3010

# Microsoft Graph / OAuth (delegated)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=*** # Microsoft Graph (app-only / client credentials)
# OUTLOOK_GRAPH_ACCESS_TOKEN=*** # AI Providers
GEMINI_API_KEY=
GEMI...n
# F-AIOS-v3 (local)
FAIOS_SERVER_URL=http://localhost:3201
LMSTUDIO_MODEL=qwen/qwen3.5-9b
AI_PROVIDER=f-aios-v3

# LM Studio (local direct)
LMSTUDIO_URL=http://localhost:1234

# Phase 1A fixture snapshot (local path; synthetic fixture is default in DEV)
# MAIL_INTELLIGENCE_NOTION_SNAPSHOT=test/fixtures/notion-jm-business-os.snapshot.json

# Phase 1B read-only Notion collect (DEFAULT OFF — do not enable on ops 3010)
# MAIL_INTELLIGENCE_NOTION_READONLY=1
# MAIL_INTELLIGENCE_NOTION_TOKEN_FILE=/absolute/path/mode600.token
# MAIL_INTELLIGENCE_NOTION_TOKEN=   # prefer TOKEN_FILE; do not commit
# MAIL_INTELLIGENCE_NOTION_DATABASE_MAP=/absolute/path/notion-database-map.local.json
# MAIL_INTELLIGENCE_NOTION_LIVE_SNAPSHOT=data/notion-readonly/live-snapshot.json
# MAIL_INTELLIGENCE_NOTION_SCHEMA_PATH=test/fixtures/notion-activity-schema.deidentified.json