# Server
PORT=3010

# Microsoft Graph / OAuth (delegated)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=*** # Microsoft Graph (app-only / client credentials)
# OUTLOOK_GRAPH_ACCESS_TOKEN=*** # AI Providers
GEMINI_API_KEY=
GEMI...n
# F-AIOS-v3 (local)
FAIOS_SERVER_URL=http://localhost:3201
LMSTUDIO_MODEL=qwen/qwen3.5-9b
AI_PROVIDER=f-aios-v3

# LM Studio (local direct)
LMSTUDIO_URL=http://localhost:1234

# Company-memory donor (optional, fail-closed). Absent = skipped.
# All four must be absolute paths. Command basename must be sb-company.
# Personal `sb` is rejected. Signing key + authority files are operator-
# provisioned; Mail does not mint a shared key or write a personal vault.
# COMPANY_MEMORY_SB_COMPANY=/home/jm/.local/bin/sb-company
# COMPANY_MEMORY_SB_COMPANY_CONFIG=/absolute/path/to/sb-company-config.json
# COMPANY_MEMORY_SIGNING_KEY_FILE=/absolute/path/to/donor-ed25519.pem
# COMPANY_MEMORY_AUTHORITY_FILE=/absolute/path/to/donor-authority.json